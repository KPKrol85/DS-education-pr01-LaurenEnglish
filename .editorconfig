# Editor consistency layer for the line-ending contract defined in .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# scripts/dev-server.py follows the 4-space Python convention already used there.
[*.py]
indent_size = 4

# Matches the `*.bat text eol=crlf` override in .gitattributes.
[*.bat]
end_of_line = crlf
